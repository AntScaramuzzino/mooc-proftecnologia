{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/corsi.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|webp|svg|css|js|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ailit",
      "destination": "/ailit/",
      "permanent": true
    },
    {
      "source": "/iainclusiva",
      "destination": "/iainclusiva/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ailit/",
      "destination": "https://mooc-alfabetizzazione-ia.vercel.app/"
    },
    {
      "source": "/ailit/:path*",
      "destination": "https://mooc-alfabetizzazione-ia.vercel.app/:path*"
    },
    {
      "source": "/iainclusiva/",
      "destination": "https://mooc-ia-inclusiva.vercel.app/"
    },
    {
      "source": "/iainclusiva/:path*",
      "destination": "https://mooc-ia-inclusiva.vercel.app/:path*"
    }
  ]
}
